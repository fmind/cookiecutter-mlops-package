{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "**/node_modules",
    "**/references/**",
    ".git",
    ".venv",
    // cookiecutter template sources contain Jinja placeholders (invalid JSON/TOML/YAML raw).
    // Exclude the directory itself (no trailing /**) so dprint also skips its nested config.
    "**/[{][{]cookiecutter.repository[}][}]"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ]
}
